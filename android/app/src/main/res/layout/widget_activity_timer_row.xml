<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/widget_timer_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#17452F" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:text="فعالیت" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <Chronometer android:id="@+id/widget_timer_elapsed" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="00:00:00" android:textSize="18sp"
            android:textColor="#17452F" android:textStyle="bold" />
        <TextView android:id="@+id/widget_timer_state" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end"
            android:text="در حال اجرا" android:textColor="#3E7258" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_timer_pause" android:layout_width="wrap_content"
            android:layout_height="36dp" android:gravity="center" android:paddingHorizontal="10dp"
            android:text="مکث" android:textColor="#17452F" android:background="#D1E8D9" />
        <TextView android:id="@+id/widget_timer_resume" android:layout_width="wrap_content"
            android:layout_height="36dp" android:gravity="center" android:paddingHorizontal="10dp"
            android:text="ادامه" android:textColor="#17452F" android:background="#D1E8D9" />
        <TextView android:id="@+id/widget_timer_finish" android:layout_width="wrap_content"
            android:layout_height="36dp" android:gravity="center" android:paddingHorizontal="10dp"
            android:text="پایان و ثبت" android:textColor="#17452F" android:background="#D1E8D9" />
    </LinearLayout>
</LinearLayout>