<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="#EDEEFF">
    <TextView
        android:id="@+id/countdown_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="تایمر معکوس"
        android:textColor="#20234A"
        android:textStyle="bold"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/countdown_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="5dp"
        android:text="برای تنظیم لمس کن"
        android:textColor="#555985"
        android:textSize="11sp" />
    <Chronometer
        android:id="@+id/countdown_widget_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:textColor="#25295B"
        android:textSize="27sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/countdown_widget_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:text="00:00"
        android:textColor="#25295B"
        android:textSize="27sp"
        android:textStyle="bold" />
</LinearLayout>
